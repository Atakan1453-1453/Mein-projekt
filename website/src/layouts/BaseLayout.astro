---
/**
 * Grundlayout aller Seiten: <head> mit SEO-Angaben, Kopf, Inhalt, Fuß.
 *
 * Props:
 *  - title        Seitentitel (ohne Suffix). Startseite: weglassen.
 *  - description  Meta-Description, 120–160 Zeichen, je Seite einzigartig.
 *  - noindex      Seite nicht in Suchmaschinen aufnehmen (z. B. Danke-Seite).
 *  - jsonLd       Strukturierte Daten (schema.org) als Objekt.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, DEMO_MODE } from '../config/site';
import interUrl from '../assets/fonts/inter-latin-wght-normal.woff2?url';
import frauncesUrl from '../assets/fonts/fraunces-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = site.description, noindex = false, jsonLd } = Astro.props;

const fullTitle = title ? `${title} | ${site.titleSuffix}` : `${site.titleSuffix} – ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    {/* Testversion: nie in Suchmaschinen aufnehmen (siehe DEMO_MODE in src/config/site.ts) */}
    {DEMO_MODE && !noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1f1940" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.titleSuffix} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} ${site.city} – ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    {
      DEMO_MODE && (
        <aside class="demo-banner" aria-label="Hinweis zur Testversion" data-demo="Testversion-Hinweis">
          <strong>Testversion</strong> – Kontakt-, Impressums- und Datenschutzangaben sowie Bilder sind fiktive Beispiele.
          Nicht zur Veröffentlichung bestimmt.
        </aside>
      )
    }
    <Header />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }

  .demo-banner {
    padding: 0.45rem var(--gutter);
    background: var(--c-gold-200);
    color: var(--c-royal-950);
    font-size: var(--step--1);
    line-height: 1.4;
    text-align: center;
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Demo from '../components/Demo.astro';
import { gallery } from '../data/gallery';

const hasDemoImages = gallery.some((img) => img.demo);
---

<BaseLayout
  title="Galerie"
  description="Bilder aus der Galerie Königshof Mettmann: Eindrücke von Ladenstraße, Shops, Gastronomie und Parkhaus an der Talstraße."
>
  <PageHero
    eyebrow="Galerie"
    title="Eindrücke aus der Galerie Königshof"
    lead="Ein Blick in Ladenstraße, Shops und Parkhaus. Klicken Sie auf ein Bild, um es in der Großansicht zu öffnen."
  />

  <section class="section" aria-labelledby="gallery-title">
    <div class="container">
      <h2 id="gallery-title" class="visually-hidden">Bilder</h2>
      {
        hasDemoImages && (
          <Demo label="Galerie-Hinweis Symbolbilder">
            <p class="note gallery-notice">Testversion: Die Bilder sind Symbolgrafiken und zeigen nicht das echte Center.</p>
          </Demo>
        )
      }
      <GalleryGrid images={gallery} />
    </div>
  </section>
</BaseLayout>

<style>
  .gallery-notice {
    margin-bottom: var(--space-xl);
  }
</style>

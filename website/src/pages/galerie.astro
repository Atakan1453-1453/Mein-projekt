---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Placeholder from '../components/Placeholder.astro';
import { gallery } from '../data/gallery';

const hasPlaceholders = gallery.some((img) => img.placeholder);
---

<BaseLayout
  title="Galerie"
  description="Bilder aus der Galerie Königshof Mettmann: Eindrücke von Ladenstraße, Shops, Gastronomie und Parkhaus an der Talstraße."
>
  <PageHero
    eyebrow="Galerie"
    title="Eindrücke aus der Galerie Königshof"
    lead="Ein Blick in Ladenstraße, Shops und Parkhaus. Klicken Sie auf ein Bild, um es in der Großansicht zu öffnen."
  />

  <section class="section" aria-labelledby="gallery-title">
    <div class="container">
      <h2 id="gallery-title" class="visually-hidden">Bilder</h2>
      {
        hasPlaceholders && (
          <div class="gallery-notice">
            <Placeholder label="Echte Fotos für die Galerie" block>
              Die Bilder unten sind neutrale Platzhalter. Bitte Fotos mit geklärten Nutzungsrechten ergänzen
              (Anleitung: WARTUNG.md → „Galerie-Fotos austauschen“).
            </Placeholder>
          </div>
        )
      }
      <GalleryGrid images={gallery} />
    </div>
  </section>
</BaseLayout>

<style>
  .gallery-notice {
    margin-bottom: var(--space-xl);
  }
</style>

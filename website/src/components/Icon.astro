---
/**
 * Schlanke Inline-SVG-Icons (eigene Linienzeichnungen, 24×24, keine externe Bibliothek).
 * Icons sind dekorativ (aria-hidden). Wenn ein Icon allein steht, muss das
 * umgebende Element eine Textalternative haben (z. B. aria-label am Button).
 */
interface Props {
  name: keyof typeof paths;
  size?: number;
  class?: string;
}

const paths = {
  'arrow-right': '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
  'chevron-left': '<path d="m15 5-7 7 7 7"/>',

  check: '<path d="m5 12.5 4.2 4.2L19 7"/>',
  crown: '<path d="M4.5 17.5 3.3 7.8l5 3.7L12 5l3.7 6.5 5-3.7-1.2 9.7Z"/><path d="M5 20h14"/>',
  calendar: '<rect x="4" y="5.5" width="16" height="14" rx="2"/><path d="M4 10h16"/><path d="M8.5 3.5v4"/><path d="M15.5 3.5v4"/>',
  info: '<circle cx="12" cy="12" r="8.5"/><path d="M12 11v5"/><path d="M12 8h.01"/>',
  alert: '<path d="M12 4 2.8 19.5h18.4Z"/><path d="M12 10v4.5"/><path d="M12 17.2h.01"/>',

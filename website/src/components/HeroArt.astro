---
/**
 * Dekorative Illustration der Startseite: ein großer Bogen mit Arkaden –
 * Anspielung auf „Galerie“ (Passage) und „Königshof“ (Krone).
 * Rein dekorativ → aria-hidden. Animation nur ohne „Bewegung reduzieren“.
 */
---

<svg class="hero-art" viewBox="0 0 520 600" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="ha-royal" x1="0" y1="0" x2="0.35" y2="1">
      <stop offset="0" stop-color="#3b3270"></stop>
      <stop offset="0.55" stop-color="#221c45"></stop>
      <stop offset="1" stop-color="#15112b"></stop>
    </linearGradient>
    <radialGradient id="ha-glow" cx="0.5" cy="0.22" r="0.55">
      <stop offset="0" stop-color="#e3c98f" stop-opacity="0.38"></stop>
      <stop offset="1" stop-color="#e3c98f" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="ha-window" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d4b16a" stop-opacity="0.05"></stop>
      <stop offset="1" stop-color="#d4b16a" stop-opacity="0.32"></stop>
    </linearGradient>
  </defs>

  <path d="M20 600V262A240 240 0 0 1 500 262V600Z" fill="url(#ha-royal)"></path>
  <path d="M20 600V262A240 240 0 0 1 500 262V600Z" fill="url(#ha-glow)"></path>

  <g class="hero-art__lines" fill="none" stroke="#d4b16a" stroke-linecap="round">
    <path class="draw" d="M50 600V266A210 210 0 0 1 470 266V600" stroke-width="1.4" opacity="0.6"></path>
    <path class="draw draw--2" d="M50 392H470" stroke-width="1" opacity="0.45"></path>
    <path class="draw draw--2" d="M50 404H470" stroke-width="1" opacity="0.25"></path>
  </g>

  <g class="hero-art__arcade">
    <path d="M70 600V482a50 50 0 0 1 100 0v118Z" fill="url(#ha-window)"></path>
    <path d="M210 600V482a50 50 0 0 1 100 0v118Z" fill="url(#ha-window)"></path>
    <path d="M350 600V482a50 50 0 0 1 100 0v118Z" fill="url(#ha-window)"></path>
    <g fill="none" stroke="#e3c98f" stroke-width="1.6">
      <path class="draw draw--3" d="M70 600V482a50 50 0 0 1 100 0v118"></path>
      <path class="draw draw--3" d="M210 600V482a50 50 0 0 1 100 0v118"></path>
      <path class="draw draw--3" d="M350 600V482a50 50 0 0 1 100 0v118"></path>
    </g>
  </g>

  <g class="hero-art__crown" transform="translate(200 148) scale(3)">
    <path d="M11.5 27.5 10 16.5l5.3 4L20 12.5l4.7 8 5.3-4-1.5 11Z" fill="#d4b16a" stroke="#d4b16a" stroke-width="1.2" stroke-linejoin="round"></path>
    <path d="M11 31h18" stroke="#d4b16a" stroke-width="1.2" stroke-linecap="round"></path>
  </g>

  <g class="hero-art__stars" fill="#e3c98f">
    <circle cx="130" cy="210" r="1.6"></circle>
    <circle cx="392" cy="196" r="1.4"></circle>
    <circle cx="172" cy="318" r="1.2"></circle>
    <circle cx="352" cy="330" r="1.6"></circle>
    <circle cx="260" cy="96" r="1.3"></circle>
    <circle cx="96" cy="350" r="1.1"></circle>
    <circle cx="430" cy="300" r="1.2"></circle>
  </g>
</svg>

<style>
  .hero-art {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 30px 50px rgb(31 25 64 / 0.28));
  }

  @media (prefers-reduced-motion: no-preference) {
    .draw {
      stroke-dasharray: 1400;
      stroke-dashoffset: 1400;
      animation: hero-draw 2.4s var(--ease-out) 0.3s forwards;
    }

    .draw--2 {
      animation-delay: 0.7s;
    }

    .draw--3 {
      animation-delay: 1s;
    }

    .hero-art__crown {
      opacity: 0;
      animation: hero-fade 1.2s var(--ease-out) 0.9s forwards;
    }

    .hero-art__stars circle {
      animation: twinkle 4s ease-in-out infinite alternate;
    }

    .hero-art__stars circle:nth-child(2n) {
      animation-delay: 1.3s;
    }

    .hero-art__stars circle:nth-child(3n) {
      animation-delay: 2.4s;
    }
  }

  @keyframes hero-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes hero-fade {
    to {
      opacity: 1;
    }
  }

  @keyframes twinkle {
    from {
      opacity: 0.25;
    }
    to {
      opacity: 1;
    }
  }
</style>

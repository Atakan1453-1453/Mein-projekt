---
/**
 * Besuchsinformationen: Adresse/Anfahrt, Öffnungszeiten, Parken.
 */
import Icon from './Icon.astro';
import { site } from '../config/site';
---

<div class="visit-grid">
  <article class="card visit-card reveal">
    <span class="visit-card__icon"><Icon name="pin" /></span>
    <h3>Anfahrt</h3>
    <address class="visit-card__address">
      {site.name}<br />
      {site.address.street}<br />
      {`${site.address.postalCode} ${site.address.city}`}
    </address>
    <a class="link-arrow" href={site.links.map} target="_blank" rel="noopener noreferrer">
      Route planen <span class="visually-hidden">(OpenStreetMap, öffnet in neuem Tab)</span>
      <Icon name="arrow-up-right" />
    </a>
  </article>

  <article class="card visit-card reveal">
    <span class="visit-card__icon"><Icon name="clock" /></span>
    <h3>Öffnungszeiten</h3>
    <p class="visit-card__hours">
      <span>{site.openingHours.days}</span>
      <strong>{site.openingHours.time}</strong>
    </p>
    <p class="visit-card__note">{site.openingHours.note}</p>
  </article>

  <article class="card visit-card reveal">
    <span class="visit-card__icon"><Icon name="parking" /></span>
    <h3>Parken</h3>
    <ul class="visit-card__list" role="list">
      {
        site.parking.facts.map((fact) => (
          <li>
            <Icon name="check" size={18} />
            <span>
              <strong>{fact.title}</strong> – {fact.text}
            </span>
          </li>
        ))
      }
    </ul>
  </article>
</div>

<style>
  .visit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-m);
  }

  .visit-card {
    display: grid;
    align-content: start;
    gap: var(--space-s);
  }

  .visit-card__icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px 999px 10px 10px;
    background: var(--c-royal-900);
    color: var(--c-gold-300);
  }

  .visit-card__address {
    font-style: normal;
    line-height: 1.7;
  }

  .visit-card__hours {
    display: grid;
  }

  .visit-card__hours strong {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.15;
    color: var(--c-royal-800);
  }

  .visit-card__note {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .visit-card__list {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    list-style: none;
  }

  .visit-card__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    align-items: start;
    line-height: 1.5;
  }

  .visit-card__list :global(svg) {
    margin-top: 0.15rem;
    color: var(--c-gold-700);
  }
</style>

{
    "name": "galerie-koenigshof/kontakt",
    "description": "Serverseitiger Handler für das Kontaktformular der Website (Validierung, Spam-Schutz, Versand per SMTP).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Koenigshof\\Kontakt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koenigshof\\Kontakt\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform-check": false
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    }
}
